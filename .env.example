# Supabase Configuration
SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_PUBLISHABLE_KEY="seu-publishable-key"
SUPABASE_URL="https://seu-project-id.supabase.co"

# Variáveis expostas ao cliente (Vite)
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="seu-publishable-key"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:18080"
EVOLUTION_API_KEY="sua_chave_evolution"
EVOLUTION_INSTANCE_NAME="teste-local"
# Instância exclusiva da franquia. Use outro número no pareamento.
EVOLUTION_ASA_SUL_INSTANCE_NAME="franquia-asasul"
# Recebimento de leads. Configure somente no servidor.
# EVOLUTION_LEAD_WEBHOOK_SECRETS={"nome-exato-da-instancia":"token-aleatorio-de-pelo-menos-32-caracteres"}
# EVOLUTION_WEBHOOK_URL="http://host.docker.internal:8081/api/webhooks/evolution"
# SUPABASE_WHATSAPP_CAPTURE_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
# Opcional para restringir administradores de integração (padrão '*' permite administradores autenticados):
EVOLUTION_MVP_ADMIN_EMAILS="*"
# Google Gemini API Key (opcional, para IA Hudson sem Lovable Gateway)
# GEMINI_API_KEY=""
VITE_EVOLUTION_API_URL="http://localhost:18080"
VITE_EVOLUTION_INSTANCE_NAME="teste-local"

# Hudson: gateway Lovable, somente no servidor (configurar em Secrets)
# LOVABLE_API_KEY="configurar_no_lovable"
# LOVABLE_AI_MODEL="modelo_habilitado_no_gateway"
